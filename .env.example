# Railway injects PORT automatically — no need to set this in Railway's dashboard
PORT=3001

# Optional: directory used for persistent draft results.
# On Railway, attach a Volume mounted at /data and set DATA_DIR=/data.
DATA_DIR=/data

# Optional: override the WebSocket URL used by the frontend at build time.
# By default the app auto-derives this from window.location in production,
# so you only need this if you're running the WS server on a separate host.
# VITE_WS_URL=wss://your-custom-ws-host.com
